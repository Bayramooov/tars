      "level": "ERROR",
      "name": "tars.engine",
      "message": "turn failed: <boom> & co",
      "out": "⚠️ ERROR — tars.engine\nturn failed: &lt;boom&gt; &amp; co"
    },
    {
      "level": "CRITICAL",
      "name": "tars",
      "message": "fatal 3",
      "out": "🔴 CRITICAL — tars\nfatal 3"
    },
    {
      "level": "ERROR",
      "name": "tars.cc_worker",
      "message": "",
      "out": "⚠️ ERROR — tars.cc_worker\…"
    },
    {
      "level": "WARNING",
      "name": "tars",
      "message": "warn only",
      "out": "⚠️ WARNING — tars\nwarn only"
    }
  ],
  "to_plain_text": [
    {
      "in": "<b>bold</b> &amp; &lt;x&gt;",
      "out": "bold & <x>"
    },
    {
      "in": "⚠️ ERROR — tars\n<blockquote>q</blockquote>",
      "out": "⚠️ ERROR — tars\nq"
    },
    {
      "in": "no tags",
      "out": "no tags"
    }
  ]
}
